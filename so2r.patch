+def test_busy_reflects_queue_and_transmit(radio, arb):
+    assert not arb.busy()
+    radio.transmitting = True
+    assert arb.busy()
+    radio.transmitting = False
+    arb.send(1, "X")  # needs a TX move: queued
+    assert arb.busy()
