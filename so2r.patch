+
+def test_send_that_never_keys_does_not_wedge(radio, arb):
+    arb.send(0, "")
+    radio.advance(2.5, arb)
+    assert not arb.busy()
+    arb.set_focus(1)
+    radio.advance(0.3, arb)
+    assert radio.log[-1] == "FT1"
